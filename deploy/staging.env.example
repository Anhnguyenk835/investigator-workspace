# Copy to .env.staging on the staging host and fill in. Never commit the real file.
POSTGRES_PASSWORD=
TAG=staging
WEB_PORT=8080

# The address people open (https, behind your reverse proxy or tunnel).
WEB_PUBLIC_URL=https://staging.example.com
# Providers redirect to {API_PUBLIC_URL}/integrations/{provider}/callback. The API is under /api on the same host.
API_PUBLIC_URL=https://staging.example.com/api
OAUTH_RETURN_URL=https://staging.example.com/settings/connectors
CORS_ORIGINS=["https://staging.example.com"]
AUTH_ENABLED=true
AUTH_COOKIE_SECURE=true
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# LLM gateway (infra/llm-gateway) and its virtual key.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Fernet key for stored tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

GUARD_ADMIN_TOKEN=
GUARD_ALIAS_SECRET=
DEMO_ENABLED=true
DEMO_DAY_COST_USD=5
