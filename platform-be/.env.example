# Virtual key minted by infra/llm-gateway/scripts/provision-virtual-key.sh.
# Never put provider keys (OpenAI/Anthropic/Gemini) here.
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=

# Local Postgres from docker-compose.yml. Holds investigations and graph checkpoints.
DATABASE_URL=postgresql://investigator:investigator@127.0.0.1:5442/investigator

# Web dev origins allowed to call the API (JSON list).
CORS_ORIGINS=["http://localhost:5173"]

# OAuth integrations (per-user connect). Generate the key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
API_PUBLIC_URL=http://127.0.0.1:8010
OAUTH_RETURN_URL=http://localhost:5173/settings/connectors
# Redirect URI to register with each provider: {API_PUBLIC_URL}/integrations/{provider}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
ATLASSIAN_CLIENT_ID=
ATLASSIAN_CLIENT_SECRET=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# What each source may read. Empty means everything the signed-in user can read.
GMAIL_LABEL=
SLACK_CHANNEL_IDS=
JIRA_PROJECT_KEYS=
JIRA_LABEL=
CONFLUENCE_SPACE_KEYS=
ATLASSIAN_SITE_URL=

# LLM guardrails: each guard is off | monitor | enforce. monitor records what it would do.
GUARD_ENABLED=true
GUARD_SECRETS_MODE=enforce
GUARD_PII_MODE=monitor
GUARD_INJECTION_MODE=monitor
GUARD_OUTPUT_MODE=monitor
GUARD_EGRESS_MODE=monitor
GUARD_BUDGET_MODE=monitor
GUARD_BREAKER_MODE=monitor
GUARD_KILL_SWITCH=false
# Unset leaves /admin/guardrails off.
GUARD_ADMIN_TOKEN=
GUARD_RUN_MAX_COST_USD=6.0
GUARD_IP_DAY_MAX_COST_USD=40.0
GUARD_GLOBAL_DAY_MAX_COST_USD=200.0
# Set to share placeholder numbering across processes.
GUARD_ALIAS_SECRET=
# Optional JSON file of policy values.
GUARD_POLICY_FILE=

# --- Sign-in and the demo (see docs/authentication.md) ---
# Off: one local user, no login, no demo. On: Google sign-in and "Use with mock data".
AUTH_ENABLED=true
# The address people open in the browser. The Google redirect URI is {WEB_PUBLIC_URL}/api/auth/google/callback
WEB_PUBLIC_URL=http://localhost:5173
# Who may sign in. Empty means any verified Google account. Comma separated.
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=
AUTH_SESSION_DAYS=14
# Set true behind https (it is also on automatically when WEB_PUBLIC_URL starts with https://).
AUTH_COOKIE_SECURE=false
DEMO_ENABLED=true
DEMO_SESSION_HOURS=24
DEMO_SESSIONS_PER_IP_HOUR=5
DEMO_MAX_INVESTIGATIONS=5
DEMO_MAX_CHAT_TURNS=40
# Real LLM spend the demo may use per day, across all visitors.
DEMO_DAY_COST_USD=10
