# Same-origin topology: the web app and the API share one host, so session cookies are
# first-party and no CORS is involved. Rendered at start from API_UPSTREAM and DNS_RESOLVER.
server {
  listen 8080;
  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # add_header does not inherit into a location that sets its own, so the shared ones are a snippet.
  location = /healthz { access_log off; return 200 "ok\n"; }

  # /api/<path> reaches the backend as /<path>. Streams (chat answers, run events) must not
  # be buffered, or they arrive all at once at the end. The upstream is named in a variable so
  # it is looked up again when its address changes (Cloud Run addresses do).
  location /api/ {
    resolver ${DNS_RESOLVER} valid=30s;
    set $upstream ${API_UPSTREAM};
    rewrite ^/api/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 3600s;
  }

  # Hashed build files never change; the page itself must always be fresh.
  location /assets/ {
    include /etc/nginx/conf.d/security.inc;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  location / {
    include /etc/nginx/conf.d/security.inc;
    add_header Cache-Control "no-cache";
    try_files $uri /index.html;
  }
}
