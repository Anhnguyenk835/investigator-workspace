# The API, as seen from the browser. /api is proxied to the backend by `npm run dev`;
# behind a reverse proxy in production, serve the API under the same origin at /api.
VITE_API_BASE_URL=/api
# Where the dev proxy sends /api (defaults to http://127.0.0.1:8010).
# API_PROXY_TARGET=http://127.0.0.1:8010
