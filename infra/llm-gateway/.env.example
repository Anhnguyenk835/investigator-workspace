# Provider credentials. The gateway holds these so no service ever does.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Admin credential for the proxy: creates and revokes virtual keys.
#   echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=

# Encrypts provider keys stored in the gateway's database.
# Changing it makes every stored key unreadable. Generate once, then leave it.
#   openssl rand -hex 24
LITELLM_SALT_KEY=
