# Copy to terraform.tfvars (git-ignored) and fill in.
project_id = "your-gcp-project-id"
region     = "asia-southeast1"

# Your domain. Leave empty to start on the run.app address.
domain = "demo.example.com"

github_repo = "Anhnguyenk835/investigator-workspace"

# Sign-in with Google (the OAuth client id is not secret).
google_client_id = ""
# Who may sign in with Google. Empty: any verified Google account.
auth_allowed_domains = ""
auth_allowed_emails  = ""

# Optional OAuth apps for connecting sources.
slack_client_id     = ""
atlassian_client_id = ""
notion_client_id    = ""

# Secrets you provide. Or leave them empty and add them later with `gcloud secrets versions add`.
gemini_api_key          = ""
openai_api_key          = ""
anthropic_api_key       = ""
google_client_secret    = ""
slack_client_secret     = ""
atlassian_client_secret = ""
notion_client_secret    = ""

# Cost guards.
demo_day_cost_usd = 5
alert_email       = ""
billing_account   = ""
budget_usd        = 100

# false stops the demo (API and gateway to zero, database stopped). true starts it again.
demo_running      = true
litellm_always_on = false
